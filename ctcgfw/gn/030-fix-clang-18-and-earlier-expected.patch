+#else
+// Fallback for standard libraries which do not provide std::expected.
+//
+// This intentionally implements only the Result<T> interface required by
+// GN. It is not intended to be a general-purpose std::expected replacement.
+//
+// std::variant is used here because GN already requires C++17 and this
+// avoids depending on any compiler-specific implementation details.
+template <typename T>
+class Result {
+  static_assert(!std::is_void_v<T>, "Use Err instead of Result<void>");
+  static_assert(!std::is_same_v<T, Err>, "Err cannot be the success case");
+
+ public:
+  // Implicit conversion from T (always creates a success state).
+  Result(const T& value) : storage_(value) {}
+
+  Result(T&& value) : storage_(std::move(value)) {}
+
+  // Implicit conversion from Err (always creates an error state).
+  Result(Err err) : storage_(std::move(err)) {
+    DCHECK(error().has_error());
+  }
+
+  bool has_value() const {
+    return std::holds_alternative<T>(storage_);
+  }
+
+  bool has_error() const {
+    return !has_value();
+  }
+
+  explicit operator bool() const {
+    return has_value();
+  }
+
+  T& operator*() & {
+    DCHECK(has_value());
+    return std::get<T>(storage_);
+  }
+
+  const T& operator*() const& {
+    DCHECK(has_value());
+    return std::get<T>(storage_);
+  }
+
+  T&& operator*() && {
+    DCHECK(has_value());
+    return std::get<T>(std::move(storage_));
+  }
+
+  const T&& operator*() const&& {
+    DCHECK(has_value());
+    return std::get<T>(std::move(storage_));
+  }
+
+  T* operator->() {
+    DCHECK(has_value());
+    return &std::get<T>(storage_);
+  }
+
+  const T* operator->() const {
+    DCHECK(has_value());
+    return &std::get<T>(storage_);
+  }
+
+  T& value() & {
+    DCHECK(has_value());
+    return std::get<T>(storage_);
+  }
+
+  const T& value() const& {
+    DCHECK(has_value());
+    return std::get<T>(storage_);
+  }
+
+  T&& value() && {
+    DCHECK(has_value());
+    return std::get<T>(std::move(storage_));
+  }
+
+  const T&& value() const&& {
+    DCHECK(has_value());
+    return std::get<T>(std::move(storage_));
+  }
+
+  Err& error() & {
+    DCHECK(has_error());
+    return std::get<Err>(storage_);
+  }
+
+  const Err& error() const& {
+    DCHECK(has_error());
+    return std::get<Err>(storage_);
+  }
+
+  Err&& error() && {
+    DCHECK(has_error());
+    return std::get<Err>(std::move(storage_));
+  }
+
+  const Err&& error() const&& {
+    DCHECK(has_error());
+    return std::get<Err>(std::move(storage_));
+  }
+
+  const std::string& message() const {
+    DCHECK(has_error());
+    return error().message();
+  }
+
+  // Keep the same API provided by the std::expected implementation above.
+  template <typename F>
+  Result<T> transform_error(F&& f) const& {
+    if (has_value())
+      return Result<T>(value());
+
+    return Result<T>(
+        std::forward<F>(f)(error()));
+  }
+
+  template <typename F>
+  Result<T> transform_error(F&& f) && {
+    if (has_value())
+      return Result<T>(std::move(value()));
+
+    return Result<T>(
+        std::forward<F>(f)(std::move(error())));
+  }
+
+ private:
+  std::variant<T, Err> storage_;
+};
+#endif  // GN_HAS_STD_EXPECTED
 
